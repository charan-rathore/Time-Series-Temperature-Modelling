# ── ThermoSense Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Location settings
LOCATION_NAME=Bangalore
LOCATION_LAT=12.9716
LOCATION_LON=77.5946
LOCATION_TIMEZONE=Asia/Kolkata

# Open-Meteo requires NO API key — it is completely free.
# https://open-meteo.com/en/docs

# OpenWeatherMap (optional — free tier = 1000 calls/day)
# Used only as a commercial-app baseline for comparison.
# Get a free key at https://openweathermap.org/api
OWM_API_KEY=your_owm_api_key_here

# API server
API_HOST=0.0.0.0
API_PORT=8000

# MLflow
MLFLOW_TRACKING_URI=./mlruns
